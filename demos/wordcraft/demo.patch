+impl WebShell {
+    /// What the demo page asked for: a .docx download, or the open document's text.
+    fn serve_demo_page(&mut self) {
+        let (want_state, want_download) = DEMO.with(|d| {
+            let mut d = d.borrow_mut();
+            (std::mem::take(&mut d.want_state), std::mem::take(&mut d.want_download))
+        });
+        // On a phone the page is wider than the screen at 100%: once the demo document is open,
+        // zoom so a Letter page (816 px) fills the screen's width. (Page Width also fits the
+        // comment balloons beside the page, which leaves the text too small to read.)
+        if !DEMO.with(|d| d.borrow().fitted) && self.app.session.path.is_some() {
+            DEMO.with(|d| d.borrow_mut().fitted = true);
+            let width = web_sys::window().and_then(|w| w.inner_width().ok()).and_then(|v| v.as_f64());
+            if let Some(w) = width.filter(|w| *w < 860.0) {
+                let percent = ((w - 40.0) / 816.0 * 100.0).floor().clamp(10.0, 100.0);
+                if let Err(e) = self.app.run("view.zoom", serde_json::json!({"value": percent})) {
+                    log::warn!("demo: couldn't zoom to the screen's width: {e}");
+                }
+            }
+        }
+        if want_download {
+            // The editor's own Save: the engine writes the document and the web build hands the
+            // bytes to the browser.
+            match self.app.run("file.save", serde_json::json!({})) {
+                Ok(v) => log::info!("demo: the editor saved the document: {v}"),
+                Err(e) => {
+                    log::error!("demo: the editor couldn't save the document: {e}");
+                    DEMO.with(|d| d.borrow_mut().error = Some(e));
+                }
+            }
+        }
+        if want_state {
+            let text = self
+                .app
+                .run("document.text", serde_json::json!({}))
+                .ok()
+                .and_then(|v| v.get("text").and_then(|t| t.as_str()).map(str::to_string))
+                .unwrap_or_default();
+            let path = self.app.session.path.as_ref().map(|p| p.to_string_lossy().to_string()).unwrap_or_default();
+            let error = DEMO.with(|d| d.borrow().error.clone());
+            let state = serde_json::json!({"path": path, "text": text, "error": error});
+            DEMO.with(|d| d.borrow_mut().state = state.to_string());
+        }
+    }
+}
