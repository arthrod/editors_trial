+/// The document the demo page opens: it sits next to the page, in the same folder.
+const DEMO_DOCUMENT: &str = "./document.docx";
+/// The name the demo document is opened under; its extension tells the engine the format.
+const DEMO_DOCUMENT_NAME: &str = "document.docx";
+
+/// What the demo page asks the editor for, and what it last saw.
+#[derive(Default)]
+struct Demo {
+    /// The editor's context, to wake it when the page asks for something.
+    ctx: Option<egui::Context>,
+    /// The page asked for the editor's state (the open document's text and file name).
+    want_state: bool,
+    /// The page asked for a .docx download.
+    want_download: bool,
+    /// The state the editor last reported, as JSON.
+    state: String,
+    /// What went wrong, if anything.
+    error: Option<String>,
+    /// The demo document has been fitted to a phone's width (done once, after it opens).
+    fitted: bool,
+}
+
+thread_local! {
+    /// The demo page's requests to the editor.
+    static DEMO: RefCell<Demo> = RefCell::new(Demo::default());
+}
+
+/// Fetch a file the page ships with (same folder, same origin).
+async fn fetch_bytes(url: &str) -> Result<Vec<u8>, String> {
+    let window = web_sys::window().ok_or("no window")?;
+    let response = wasm_bindgen_futures::JsFuture::from(window.fetch_with_str(url)).await.map_err(|e| format!("{e:?}"))?;
+    let response: web_sys::Response = response.dyn_into().map_err(|_| "not a response")?;
+    if !response.ok() {
+        return Err(format!("{url}: HTTP {}", response.status()));
+    }
+    let buffer = wasm_bindgen_futures::JsFuture::from(response.array_buffer().map_err(|e| format!("{e:?}"))?).await.map_err(|e| format!("{e:?}"))?;
+    Ok(js_sys::Uint8Array::new(&buffer).to_vec())
+}
+
+/// Open the demo document: its bytes go into the app's inbox, where the app's own `file.open`
+/// picks them up — the same path a file chosen in the browser's picker takes.
+fn open_demo_document(inbox: Inbox, ctx: egui::Context) {
+    wasm_bindgen_futures::spawn_local(async move {
+        match fetch_bytes(DEMO_DOCUMENT).await {
+            Ok(bytes) => {
+                log::info!("demo: fetched {DEMO_DOCUMENT} ({} bytes); opening it", bytes.len());
+                inbox.lock().unwrap_or_else(|e| e.into_inner()).push((DEMO_DOCUMENT_NAME.to_string(), bytes));
+                ctx.request_repaint();
+            }
+            Err(e) => {
+                log::error!("demo: couldn't fetch {DEMO_DOCUMENT}: {e}");
+                DEMO.with(|d| d.borrow_mut().error = Some(format!("couldn't fetch {DEMO_DOCUMENT}: {e}")));
+            }
+        }
+    });
+}
+
+/// The demo page's own API, on `window.wordcraftDemo`: its "Download .docx" button, and the
+/// checks that read the open document back out of the editor.
+fn install_demo_api() {
+    let Some(window) = web_sys::window() else { return };
+    let api = js_sys::Object::new();
+    let mut set = |name: &str, value: &wasm_bindgen::JsValue| {
+        if let Err(e) = js_sys::Reflect::set(&api, &wasm_bindgen::JsValue::from_str(name), value) {
+            log::warn!("demo: couldn't set {name}: {e:?}");
+        }
+    };
+    // "Download .docx": the editor's own Save, which the web build turns into a download.
+    let download = wasm_bindgen::closure::Closure::<dyn Fn()>::new(|| {
+        let ctx = DEMO.with(|d| d.borrow().ctx.clone());
+        DEMO.with(|d| d.borrow_mut().want_download = true);
+        if let Some(ctx) = ctx {
+            ctx.request_repaint();
+        }
+    });
+    set("downloadDocx", &download.into_js_value());
+    // Ask the editor for its state, then read the answer it last gave.
+    let request = wasm_bindgen::closure::Closure::<dyn Fn()>::new(|| {
+        let ctx = DEMO.with(|d| d.borrow().ctx.clone());
+        DEMO.with(|d| d.borrow_mut().want_state = true);
+        if let Some(ctx) = ctx {
+            ctx.request_repaint();
+        }
+    });
+    set("requestState", &request.into_js_value());
+    let state = wasm_bindgen::closure::Closure::<dyn Fn() -> String>::new(|| DEMO.with(|d| d.borrow().state.clone()));
+    set("state", &state.into_js_value());
+    if let Err(e) = js_sys::Reflect::set(&window, &wasm_bindgen::JsValue::from_str("wordcraftDemo"), &api) {
+        log::warn!("demo: couldn't install the page's API: {e:?}");
+    }
+}
